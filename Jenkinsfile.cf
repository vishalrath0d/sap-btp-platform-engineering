// Project "Piper" pipeline for the whole Cloud Foundry-bound landscape -
// now five services, not four: spend-anomaly-detector moved here
// temporarily (see its own manifest.yml's comment, and .github/workflows/
// cf-deploy.yml's identical addition) while its real target, Kyma, is
// blocked on SAP's trial-approval process (docs/next/next.md). One
// pipeline, not one per service, same reasoning as
// .github/workflows/cf-deploy.yml: these five are a bound landscape, not
// five independently-released products, so deploying them is one
// pipeline's job even though testing each stays its own concern.
//
// Explicit scripted stages, not the implicit `piperPipeline script: this`
// form alone would drive - a deliberate choice, not a style preference:
// this pipeline calls cloudFoundryDeploy FIVE times with three different
// parameter sets (one MTA deploy via mtaDeployPlugin, four cf_native
// pushes against different manifests) - the implicit form applies one
// global parameter set per step name from config.yml, which can't express
// "call this step four times, differently" on its own. This project's own
// ci-cd/piper/README.md already names explicit stages as valid, real
// Piper usage for exactly this reason. The repo-root `.pipeline/
// config.yml` is still real and still read by every step call below
// (explicit stages don't opt out of Piper's own config-file resolution) -
// it carries the settings genuinely shared across both this pipeline and
// Jenkinsfile.kyma (general.buildTool, lint/test toggles); per-module
// deploy parameters that differ between the four CF apps live in this
// file's explicit stage calls instead, since Piper's default config file
// is one shared file per checkout, not a separate one per pipeline.
//
// Every step name and parameter below verified against SAP/jenkins-
// library's real step metadata (mtaBuild.yaml, cloudFoundryDeploy.yaml)
// and the current project-piper.io docs for cf_native's `manifest`/
// `cloudFoundry.*` shape - not written from memory.

@Library('piper-lib-os') _

// org is this trial's real, SAP-assigned CF org name (confirmed via
// `cf orgs`), not 'procureiq-dev' - see .github/workflows/cf-deploy.yml's
// identical comment for why. Update this literal if the org ever changes.
def cfTarget = [
    apiEndpoint  : 'https://api.cf.us10.hana.ondemand.com',
    org          : '4cbf0c12trial',
    space        : 'dev',
    credentialsId: 'procureiq-cf-credentials',
]

pipeline {
    agent any
    stages {

        // `when { changeset "..." }` is Jenkins Declarative Pipeline's own
        // real, built-in mechanism for exactly this (not a plugin) - the
        // same "only test the service that actually changed" property
        // .github/workflows/test.yml's dorny/paths-filter job gives on the
        // GitHub Actions side, expressed in Jenkins's own native syntax
        // instead of a third-party action.
        stage('Test') {
            parallel {
                stage('procurement-core') {
                    when { changeset "services/procurement-core/**" }
                    steps { dir('services/procurement-core') { sh 'npm ci && npm test' } }
                }
                stage('ai-copilot') {
                    when { changeset "services/ai-copilot/**" }
                    steps { dir('services/ai-copilot') { sh 'npm ci && npm test' } }
                }
                stage('api-gateway') {
                    when { changeset "services/api-gateway/**" }
                    steps { dir('services/api-gateway') { sh 'npm ci && npm test' } }
                }
                stage('legacy-erp-gateway') {
                    when { changeset "services/legacy-erp-gateway/**" }
                    steps { dir('services/legacy-erp-gateway') { sh 'npm ci && npm test' } }
                }
                stage('spend-anomaly-detector') {
                    when { changeset "services/spend-anomaly-detector/**" }
                    steps { dir('services/spend-anomaly-detector') { sh 'npm ci && npm test' } }
                }
            }
        }

        stage('Build MTA - procurement-core') {
            when { changeset "services/procurement-core/**" }
            steps {
                dir('services/procurement-core') {
                    // `-p @sap/cds-dk` pinned explicitly, not bare `npx
                    // cds` - real failure hit live in this repo's GitHub
                    // Actions CI ("could not determine executable to
                    // run"): @sap/cds is a real dependency here but
                    // doesn't ship the `cds` CLI itself (that's the
                    // separate @sap/cds-dk package), and npx's on-the-fly
                    // fetch-and-resolve for a bare `cds` isn't reliable.
                    sh 'npx -p @sap/cds-dk cds build --production'
                    mtaBuild script: this, platform: 'CF', mtaBuildTool: 'cloudMbt'
                }
            }
        }

        // Deploy stages are real and complete but not wired to run
        // automatically - `when { expression { false } }` is this
        // pipeline's equivalent of the GitHub Actions workflows'
        // `if: false`, same build-first, deploy-after-review posture
        // (PROJECT_CHARTER.md). Flip to `expression { true }` (or a real
        // approval/branch condition) once ready.

        stage('Deploy - procurement-core (MTA)') {
            when { expression { false } }
            steps {
                dir('services/procurement-core') {
                    cloudFoundryDeploy script: this,
                        deployType: 'standard',
                        mtaDeployParameters: '-f --version-rule ALL',
                        mtaExtensionDescriptor: 'mtaext-dev.mtaext',
                        cloudFoundry: cfTarget
                }
            }
        }

        stage('Deploy - ai-copilot, legacy-erp-gateway, spend-anomaly-detector, api-gateway (cf_native)') {
            when { expression { false } }
            steps {
                dir('services/ai-copilot') {
                    cloudFoundryDeploy script: this, deployTool: 'cf_native', deployType: 'standard', cloudFoundry: cfTarget
                }
                dir('services/legacy-erp-gateway') {
                    cloudFoundryDeploy script: this, deployTool: 'cf_native', deployType: 'standard', cloudFoundry: cfTarget
                }
                dir('services/spend-anomaly-detector') {
                    // Temporary CF home - see manifest.yml's comment.
                    // Same shape as ai-copilot/legacy-erp-gateway above.
                    cloudFoundryDeploy script: this, deployTool: 'cf_native', deployType: 'standard', cloudFoundry: cfTarget
                }
                dir('services/api-gateway') {
                    cloudFoundryDeploy script: this, deployTool: 'cf_native', deployType: 'standard', cloudFoundry: cfTarget
                    // Same real ordering dependency cf-deploy.yml documents:
                    // api-gateway needs procurement-core's live route.
                    sh '''
                        CORE_GUID=$(cf app procurement-core-srv --guid)
                        CORE_URL=$(cf curl "/v3/apps/${CORE_GUID}/routes" | jq -r '.resources[0].url')
                        cf set-env api-gateway PROCUREMENT_CORE_URL "https://${CORE_URL}/procurement"
                        cf restage api-gateway
                    '''
                }
            }
        }

        stage('Wire procurement-core outbound URLs') {
            // Same reverse-direction wiring cf-deploy.yml's dedicated job
            // does - procurement-core calls OUT to legacy-erp-gateway and
            // spend-anomaly-detector (srv/lib/destination.js,
            // srv/lib/events.js), both need their real deployed routes.
            when { expression { false } }
            steps {
                sh '''
                    ANOMALY_GUID=$(cf app spend-anomaly-detector --guid)
                    ANOMALY_URL=$(cf curl "/v3/apps/${ANOMALY_GUID}/routes" | jq -r '.resources[0].url')
                    LEGACY_GUID=$(cf app legacy-erp-gateway --guid)
                    LEGACY_URL=$(cf curl "/v3/apps/${LEGACY_GUID}/routes" | jq -r '.resources[0].url')

                    cf set-env procurement-core-srv SPEND_ANOMALY_DETECTOR_URL "https://${ANOMALY_URL}/events/purchase-order-created"
                    cf set-env procurement-core-srv LEGACY_SUPPLIER_ERP_URL "https://${LEGACY_URL}"
                    cf restage procurement-core-srv
                '''
            }
        }
    }
}
